DirectoryIndex index.php public/index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Lindungi berkas sensitif dari akses publik langsung
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml) - [F,L]
    RewriteRule \.sql$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage/logs|tests|vendor) - [F,L]

    # 2. Redirect root langsung ke halaman login
    RewriteRule ^$ login/login.html [R=302,L]

    # 3. Jika berkas fisik memang ada di dalam folder public/, sajikan langsung
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 4. Jika direktori fisik memang ada di dalam folder public/, sajikan langsung
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # 5. Sisanya (endpoint API & rute Laravel) arahkan ke front controller
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>
