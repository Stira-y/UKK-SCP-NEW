DirectoryIndex index.php public/index.php index.html

# Gunakan PHP 8.4 di LiteSpeed / CloudLinux
<FilesMatch "\.(php4|php5|php3|php2|php|phtml)$">
    SetHandler application/x-httpd-alt-php84___lsphp
</FilesMatch>

# Matikan cache pada file HTML, JS, dan CSS agar perubahan UI & perbaikan kode selalu langsung aktif di browser
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|js|css)$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
</IfModule>

<IfModule pagespeed_module>
    ModPagespeed off
</IfModule>
<IfModule mod_pagespeed.c>
    ModPagespeed off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Lindungi berkas sensitif dari akses publik langsung
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml) - [F,L]
    RewriteRule \.sql$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor) - [F,L]
    RewriteRule ^storage/app/(?!public/).* - [F,L]

    # 2. Redirect root langsung ke halaman login
    RewriteRule ^$ login/login.html [R=302,L]

    # 2.5. Sajikan berkas penyimpanan publik (avatar, file uploads)
    RewriteCond %{DOCUMENT_ROOT}/storage/app/public/$2 -f
    RewriteRule ^(public/)?storage/(.*)$ storage/app/public/$2 [L]
    RewriteCond %{DOCUMENT_ROOT}/storage/app/public/$1 -f
    RewriteRule ^storage/(.*)$ storage/app/public/$1 [L]

    # 3. Jika berkas fisik memang ada di root, sajikan langsung
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 4. Jika direktori fisik memang ada di root (selain root itu sendiri), sajikan langsung
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. Jika berkas fisik ada di dalam folder public/, sajikan langsung
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 6. Jika direktori fisik ada di dalam folder public/, sajikan langsung
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # 7. Sisanya (endpoint API & rute Laravel) arahkan ke front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>
